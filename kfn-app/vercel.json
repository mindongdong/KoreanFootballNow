{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/articles.ts": {
      "includeFiles": "src/data/articles/**"
    },
    "api/subscribe.ts": {
      "includeFiles": "{newsletters/**,src/data/articles/**}"
    },
    "api/player-stats.ts": {
      "maxDuration": 10
    },
    "api/player-profile.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|.*\\.csv$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.csv",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
