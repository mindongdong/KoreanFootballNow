FROM alpine:3.22 AS chromium-builder

# chromium 설치 (apk가 모든 런타임 의존성을 자동 해결)
RUN apk add --no-cache chromium font-noto-cjk ttf-freefont

FROM n8nio/n8n:latest

USER root

# /usr/bin/chromium-browser (wrapper script)
COPY --from=chromium-builder /usr/bin/chromium-browser /usr/bin/chromium-browser

# /usr/lib 전체 (chromium 바이너리 + 모든 공유 라이브러리)
COPY --from=chromium-builder /usr/lib /usr/lib

# 폰트
COPY --from=chromium-builder /usr/share/fonts /usr/share/fonts
COPY --from=chromium-builder /etc/fonts /etc/fonts

# 심볼릭 링크
RUN ln -sf /usr/bin/chromium-browser /usr/bin/chromium

# 환경 변수
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/usr/bin \
    NODE_PATH=/opt/n8n-custom/node_modules

# 커스텀 모듈 디렉토리
RUN mkdir -p /opt/n8n-custom && \
    chown -R node:node /opt/n8n-custom

USER node

# Playwright 설치
WORKDIR /opt/n8n-custom
RUN npm init -y && npm install playwright-core

# FotMob 스크래퍼
COPY --chown=node:node fotmob-scraper.js /opt/n8n-custom/fotmob-scraper.js

# 검증
RUN node -e "const { chromium } = require('playwright-core'); console.log('Playwright OK');"

WORKDIR /home/node
